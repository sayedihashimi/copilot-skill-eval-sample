--- a/dotnet-net11/README.md
+++ b/dotnet-net11/README.md
@@ -0,0 +1,21 @@
+# dotnet-net11 plugin
+
+Generates .NET 11-first code with emphasis on new APIs and language features.
+
+## Included skills
+- `net11-features`
+- `net11-bcl-core`
+- `net11-json-webapi`
+- `net11-csharp15`
+- `net11-focus-dimensions`
+
+## Included agents
+- `net11-adoption-reviewer` (post-generation audit for priority dimensions)
+
+## Coverage policy
+This plugin must demonstrate the priority dimensions even when a scenario does not
+naturally require them. Add small, isolated demo helpers (for example
+`FeatureCoverage/Net11PriorityApiDemo.cs`) instead of marking features "not applicable".
+
+## Usage intent
+Use this plugin when creating or refactoring code to target `net11.0` and prioritize built-in .NET 11 APIs over legacy/third-party alternatives.

--- a/dotnet-net11/scripts\net11-pattern-guard.ps1
+++ b/dotnet-net11/scripts\net11-pattern-guard.ps1
@@ -0,0 +1,39 @@
+param(
+    [string]$RepoRoot = (Get-Location).Path
+)
+
+$ErrorActionPreference = "Stop"
+
+$checks = @(
+    @{ Name = "Missing BFloat16"; Must = "BFloat16"; Scope = "*.cs" },
+    @{ Name = "Missing Rune APIs"; Must = "Rune"; Scope = "*.cs" },
+    @{ Name = "Missing HMAC verify"; Must = "HMACSHA256.Verify|VerifyHmac"; Scope = "*.cs" },
+    @{ Name = "Legacy hash+compare"; Ban = "HashData\(|FixedTimeEquals\("; Scope = "*.cs" },
+    @{ Name = "Legacy FrozenDictionary pattern"; Ban = "ToFrozenDictionary\("; Scope = "*.cs" },
+    @{ Name = "Missing collection with()"; Must = "with\(capacity:|with\(comparer:"; Scope = "*.cs" },
+    @{ Name = "Missing union"; Must = "\bunion\b"; Scope = "*.cs" },
+    @{ Name = "Missing DivisionRounding"; Must = "DivisionRounding\."; Scope = "*.cs" },
+    @{ Name = "Missing JsonNamingPolicy attribute"; Must = "\[JsonNamingPolicy\("; Scope = "*.cs" },
+    @{ Name = "Disallowed not-applicable note"; Ban = "Not applicable"; Scope = "*.md" }
+)
+
+$files = Get-ChildItem -Path $RepoRoot -Recurse -File | Where-Object { $_.Extension -in @(".cs", ".md") }
+$issues = @()
+
+foreach ($check in $checks) {
+    $scopeFiles = $files | Where-Object { $_.Name -like $check.Scope }
+    $pattern = if ($check.ContainsKey("Must")) { $check.Must } else { $check.Ban }
+    $matches = $scopeFiles | Select-String -Pattern $pattern -AllMatches -SimpleMatch:$false
+
+    if ($check.ContainsKey("Must") -and -not $matches) {
+        $issues += "Missing required pattern: $($check.Name)"
+    }
+    if ($check.ContainsKey("Ban") -and $matches) {
+        $issues += "Found banned pattern: $($check.Name)"
+    }
+}
+
+if ($issues.Count -gt 0) {
+    $issues | ForEach-Object { Write-Error $_ }
+    exit 1
+}

